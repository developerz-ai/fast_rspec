# frozen_string_literal: true

source 'https://rubygems.org'

gem 'factory_bot', path: ENV.fetch('ORACLE_SRC')
gem 'fast_rspec', path: File.expand_path('../../..', __dir__)
gem 'rake'
# Bundler does not install a path gem's development dependencies, so the spec
# suite's needs are listed here: rspec (ships the runner executable),
# rspec-its and simplecov (both required by spec/spec_helper.rb), and
# activerecord + sqlite3 for the acceptance specs, mirroring upstream's own
# Gemfile at this pin.
gem 'activerecord'
gem 'rspec'
gem 'rspec-its'
gem 'simplecov'
gem 'sqlite3'
