#!/usr/bin/env bash
# Oracle suite runner for minitest: runs the upstream suite against fast_rspec's
# compat shims. The runner injects ORACLE_SRC, FAST_RSPEC_ROOT, ORACLE_NAME,
# BUNDLE_GEMFILE (this oracle's overlay Gemfile) and RUBYOPT=-rcompat_shadow;
# run scripts never touch RUBYOPT or the bundle themselves.
# Once the suite completes, the counts parsed from its own summary line are
# printed as `ORACLE RESULT pass=<n> fail=<n> skip=<n>`; exiting without that
# line makes the runner classify the run as a skip whose reason is this output.
set -euo pipefail
cd "$ORACLE_SRC"

suite_status=0
output="$(bundle exec rake 2>&1)" || suite_status=$?
printf '%s\n' "$output"

# Suite summaries decide the counts; without one the suite never completed.
# The LAST summary wins: suites echo totals-line-shaped literals in failure
# output when they fail. minitest: "12 runs, 24 assertions, 0 failures, ..."
summary_re='([0-9]+) runs, ([0-9]+) assertions, ([0-9]+) failures, ([0-9]+) errors, ([0-9]+) skips'
line=''
runs=0
failures=0
errors=0
skips=0
rest=$output
while [[ $rest =~ $summary_re ]]; do
  line=${BASH_REMATCH[0]}
  runs=${BASH_REMATCH[1]}
  failures=${BASH_REMATCH[3]}
  errors=${BASH_REMATCH[4]}
  skips=${BASH_REMATCH[5]}
  rest=${rest#*"$line"}
done

if [[ -n $line ]]; then
  if ((runs > 0)); then
    printf 'ORACLE RESULT pass=%d fail=%d skip=%d\n' \
      $((runs - failures - errors - skips)) $((failures + errors)) "$skips"
    exit 0
  fi
  printf 'oracle %s: suite completed with 0 runs - nothing executed\n' "${ORACLE_NAME:-?}"
  exit 1
fi

# rspec totals fallback for rake tasks that shell out to rspec: "12 examples,
# 0 failures" / "5 examples, 1 failure, 2 pending" / "2 examples, 0 failures,
# 1 error occurred outside of examples" - errors outside of examples (e.g. a
# spec file that failed to load) fold into failures so silently missing specs
# never read as a pass (the last one wins).
rspec_re='([0-9]+) examples?, ([0-9]+) failures?(, ([0-9]+) pending?)?(, ([0-9]+) errors? occurred outside of examples)?'
line=''
examples=0
failures=0
pending=0
rest=$output
while [[ $rest =~ $rspec_re ]]; do
  line=${BASH_REMATCH[0]}
  examples=${BASH_REMATCH[1]}
  failures=${BASH_REMATCH[2]}
  pending=${BASH_REMATCH[4]:-0}
  failures=$((failures + ${BASH_REMATCH[6]:-0}))
  rest=${rest#*"$line"}
done

if [[ -n $line ]]; then
  if ((examples > 0)); then
    printf 'ORACLE RESULT pass=%d fail=%d skip=%d\n' \
      $((examples - failures - pending)) "$failures" "$pending"
    exit 0
  fi
  printf 'oracle %s: suite completed with 0 examples - nothing executed\n' "${ORACLE_NAME:-?}"
  exit 1
fi

# No summary line: the suite crashed before completing (load error, abort).
((suite_status > 0)) || suite_status=1
exit "$suite_status"
