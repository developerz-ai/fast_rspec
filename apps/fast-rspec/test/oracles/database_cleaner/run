#!/usr/bin/env bash
# Oracle suite runner for database_cleaner: runs the upstream suite against
# fast_rspec's compat shims. The runner injects ORACLE_SRC, FAST_RSPEC_ROOT,
# ORACLE_NAME, BUNDLE_GEMFILE (this oracle's overlay Gemfile) and
# RUBYOPT=-rcompat_shadow; run scripts never touch RUBYOPT or the bundle.
# Upstream's rake default task is [:spec, :features]: :features is cucumber,
# whose output has no parseable summary line, so a completed rake run could
# never print an honest RESULT - and the Rakefile requires cucumber/rake/task
# unconditionally, aborting rake under this overlay before any suite code.
# This script runs the spec suite exactly the way upstream's rake :spec task
# runs it (default spec/**/*_spec.rb pattern, options from .rspec) and lets
# rspec's totals line decide: the counts are printed as `ORACLE RESULT
# pass=<n> fail=<n> skip=<n>`; exiting without that line makes the runner
# classify the run as a skip whose reason is this output.
set -euo pipefail
cd "$ORACLE_SRC"

suite_status=0
output="$(bundle exec rspec 2>&1)" || suite_status=$?
printf '%s\n' "$output"

# rspec's totals line decides the counts; without one the suite never ran to
# completion. The LAST totals line wins: suites echo totals-line-shaped
# literals in failure output when they fail.
# "12 examples, 0 failures" / "5 examples, 1 failure, 2 pending" /
# "2 examples, 0 failures, 1 error occurred outside of examples" - errors
# outside of examples (e.g. a spec file that failed to load) fold into
# failures so silently missing specs never read as a pass.
summary_re='([0-9]+) examples?, ([0-9]+) failures?(, ([0-9]+) pending?)?(, ([0-9]+) errors? occurred outside of examples)?'
line=''
examples=0
failures=0
pending=0
rest=$output
while [[ $rest =~ $summary_re ]]; do
  line=${BASH_REMATCH[0]}
  examples=${BASH_REMATCH[1]}
  failures=${BASH_REMATCH[2]}
  pending=${BASH_REMATCH[4]:-0}
  failures=$((failures + ${BASH_REMATCH[6]:-0}))
  rest=${rest#*"$line"}
done

if [[ -n $line ]]; then
  if ((examples > 0)); then
    printf 'ORACLE RESULT pass=%d fail=%d skip=%d\n' \
      $((examples - failures - pending)) "$failures" "$pending"
    exit 0
  fi
  printf 'oracle %s: suite completed with 0 examples - nothing executed\n' "${ORACLE_NAME:-?}"
  exit 1
fi

# No summary line: the suite crashed before completing (load error, abort).
((suite_status > 0)) || suite_status=1
exit "$suite_status"
