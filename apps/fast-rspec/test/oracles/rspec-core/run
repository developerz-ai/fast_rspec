#!/usr/bin/env bash
# Oracle suite runner for rspec-core: runs the upstream spec suite against
# fast_rspec's compat shims. The runner injects ORACLE_SRC, FAST_RSPEC_ROOT,
# ORACLE_NAME, BUNDLE_GEMFILE (this oracle's overlay Gemfile) and
# RUBYOPT=-rcompat_shadow; run scripts never touch RUBYOPT or the bundle.
# Once the suite completes, the counts parsed from rspec's totals line are
# printed as `ORACLE RESULT pass=<n> fail=<n> skip=<n>`; exiting without that
# line makes the runner classify the run as a skip whose reason is this output.
set -euo pipefail
# rspec releases from its monorepo; the suite lives in its rspec-core/ dir.
cd "$ORACLE_SRC/rspec-core"

# The suite output is streamed into a log file while it runs: a suite the
# runner kills on timeout leaves its partial output behind, so the skip reason
# can say where the suite hung.
suite_status=0
log="$(mktemp)"
trap 'rm -f "$log"' EXIT
bundle exec rspec 2>&1 | tee "$log" || suite_status=$?

# The totals line decides the counts. One shared helper owns the parsing
# (test/oracles/support/totals.rb) so the unit suite can pin it: rspec's
# totals line is "12 examples, 0 failures" / "5 examples, 1 failure, 2 pending" /
# "2 examples, 0 failures, 1 error occurred outside of examples" - errors
# outside of examples (e.g. a spec file that failed to load) fold into
# failures so silently missing specs never read as a pass. The LAST totals
# line wins: rspec-core's own suite echoes totals-line-shaped literals in
# failure output when it fails.
# The helper is plain Ruby, so RUBYOPT is cleared: it must not run inside the
# shadowed bundle.
if RUBYOPT= ruby "$FAST_RSPEC_ROOT/test/oracles/support/totals.rb" \
     --dialect rspec --oracle "${ORACLE_NAME:-?}" "$log"; then
  exit 0
fi

# No totals line (the suite crashed before completing) or nothing executed:
# the helper says why on stderr; exit with the suite's own status.
((suite_status > 0)) || suite_status=1
exit "$suite_status"
