#!/usr/bin/env bash
# The one command before a PR: CI's required gates on the active Ruby engine.
# CI additionally covers its Ruby matrix; this command does not switch Rubies.
#   bin/check        lint + compile + unit + forced-PureRuby unit + package smoke
#                    compile and forced-PureRuby unit run only on CRuby
#   bin/check fast   lint + unit (intentional subset)
#   bin/check full   default gates + oracles + demo apps
set -euo pipefail
cd "$(dirname "$0")/.."

command -v bundle >/dev/null || { echo "bin/check: bundler missing — environment, not a verdict" >&2; exit 75; }

MODE="${1:-pr}"
failed=()
stage() {
  local name="$1"; shift; local t0; t0=$(date +%s)
  echo; echo "==> ${name}"
  if "$@"; then echo "    ✓ ${name} ($(($(date +%s) - t0))s)"; else echo "    ✗ ${name}"; failed+=("$name"); fi
}

stage lint bundle exec rubocop
if [ "$MODE" != fast ]; then
  ENGINE="$(ruby -e 'print RUBY_ENGINE')"
  if [ "$ENGINE" = ruby ]; then
    stage compile bundle exec rake compile
  fi
fi
stage unit bundle exec rake test
if [ "$MODE" != fast ]; then
  if [ "$ENGINE" = ruby ]; then
    stage unit-pure-ruby env FAST_RSPEC_DISABLE_EXT=1 bundle exec rake test
  fi
  stage smoke bundle exec rake smoke
fi
if [ "$MODE" = full ]; then
  stage oracles bundle exec rake test:oracles
  stage apps bundle exec rake test:apps
fi

[ ${#failed[@]} -eq 0 ] && echo && echo "✓ all green" || { echo; echo "✗ failed: ${failed[*]}"; exit 1; }
