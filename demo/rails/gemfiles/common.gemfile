# frozen_string_literal: true

# Gems shared by both stacks. Loaded via `eval_gemfile` from upstream.gemfile / fast_rspec.gemfile.
source 'https://rubygems.org'

gem 'puma', '>= 5.0'
gem 'rails', '~> 8.1.4'
gem 'sqlite3', '>= 2.1'
gem 'tzinfo-data', platforms: %i[windows jruby]

group :test do
  # Wired, not rebuilt, by fast_rspec — kept in both stacks.
  gem 'capybara'
  gem 'cuprite'
  gem 'shoulda-context'
  gem 'shoulda-matchers'
end
