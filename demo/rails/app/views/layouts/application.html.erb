<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Blog Demo" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
  </head>
  <body>
    <nav><%= link_to "Posts", posts_path %> · <%= link_to "New post", new_post_path %> · <%= link_to "Weather", weather_path %></nav>
    <% if notice %><p id="notice"><%= notice %></p><% end %>
    <% if alert %><p id="alert"><%= alert %></p><% end %>
    <main><%= yield %></main>
  </body>
</html>
