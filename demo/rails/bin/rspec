#!/usr/bin/env ruby
# frozen_string_literal: true

# `bin/rspec` = `bundle exec rspec` against gemfiles/$STACK.gemfile (default: upstream).
# On STACK=fast_rspec the `rspec` executable must come from the fast_rspec gem.
ENV['BUNDLE_GEMFILE'] ||= File.expand_path("../gemfiles/#{ENV.fetch('STACK', 'upstream')}.gemfile", __dir__)
Dir.chdir(File.expand_path('..', __dir__))
exec('bundle', 'exec', 'rspec', *ARGV)
