#!/usr/bin/env bash
# pre-commit — owned by this repository's maintainers. Lint only (~4 s): the hook stays fast
# enough that nobody skips it. The tests are `bin/check`, before a PR, and CI.
# ACTIVATE IT (once, per clone): git config core.hooksPath .githooks
set -euo pipefail
cd "$(dirname "$0")/../apps/fast-rspec"
exec bundle exec rubocop
